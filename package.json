{
  "name": "sean-adventure",
  "version": "1.0.0",
  "private": true,
  "description": "Sean Adventure, an offline Montessori learning game for ages 3 to 6.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node tools/build-www.mjs",
    "cap:sync": "npm run build:web && cap sync",
